        <mxCell id="n8SFJ8Kha0C8RZgxG9Iu-22" value="        Gateway                                                                                    { MobileGateway }&#xa;        Регистрация и авторизация пользователей                          { Identity}&#xa;        Управление пользователями                         { Users }&#xa;        Регистрация устройств и управление устройствами            { Sensors }&#xa;&#xa;&#xa;        Управление отоплением                                                          { TemperatureControl }&#xa;        Управление освещением                                                         { LightControl }&#xa;        Управление воротами                                                              { GateControl }&#xa;        Управление видеонаблюдением                                             { VideoSurveillanceControl }&#xa;        &#xa;        Мониторинг телеметрии                                                          { Telemetry }&#xa;&#xa;&#xa;        Управление подпиской                                                            { Subscriptions }&#xa;        Управление платежами                                                           { Payments }&#xa;        Упарвление планировкой дома                                              { HouseLayouts }&#xa;        Управление сценариями                                                         { Scenarios }&#xa;        Нотификация                                                                            { Notificatons }" style="text;whiteSpace=wrap;" parent="1" vertex="1">
